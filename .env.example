# Discovery and report ingestion (Envio by default; rpc keeps legacy acquisition).
YEARN_DATA_EVENT_SOURCE=envio
YEARN_ENVIO_GRAPHQL_URL=
# Optional metadata endpoint; defaults to https://kong.yearn.fi/api/gql
YEARN_KONG_GRAPHQL_URL=https://kong.yearn.fi/api/gql
# Optional tuning: YEARN_ENVIO_PAGE_SIZE=1000, YEARN_ENVIO_WINDOW_BLOCKS=1000000
# Archive endpoints for explicitly selected historical chains.
OPTIMISM_RPC_URL=
FANTOM_RPC_URL=

# Historical TVL uses UTC day-close Yearn Prices and archive RPC state.
# Set YEARN_PRICE_PROD_KEY to your existing Yearn Prices read key.
# Optional: ARCHIVE_RPC_URL_<chainId> or RPC_URI_FOR_<chainId> overrides named chain RPCs.
# Archive settings also supply ordinary full-node reads; named RPCs remain fallbacks.
ARCHIVE_RPC_URL_1=
ARCHIVE_RPC_URL_10=
ARCHIVE_RPC_URL_100=
ARCHIVE_RPC_URL_137=
ARCHIVE_RPC_URL_250=
ARCHIVE_RPC_URL_4663=
ARCHIVE_RPC_URL_8453=
ARCHIVE_RPC_URL_42161=
ARCHIVE_RPC_URL_999=
ARCHIVE_RPC_URL_747474=

# Independent curation discovery (optional override):
YEARN_MORPHO_GRAPHQL_URL=https://api.morpho.org/graphql

# Optional Postgres storage. Explicitly select it with --db neon.
# Keep credentials here; publication files store only the logical name neon.
NEON_DB_URL=
# Optional default for local commands; --db always overrides it.
# YEARN_DATA_DB=neon
# Separate local Postgres staging database; select with --db staging.
STAGING_DB_URL=
# Optional non-public Postgres schema (must already exist).
# YEARN_DATA_DB_SCHEMA=public
